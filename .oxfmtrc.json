{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 80,
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      { "groupName": "react", "elementNamePattern": ["react", "react/**"] },
      { "groupName": "next", "elementNamePattern": ["next", "next/**"] },
      { "groupName": "assets", "elementNamePattern": ["@assets/**"] },
      { "groupName": "components", "elementNamePattern": ["@components/**"] },
      { "groupName": "data", "elementNamePattern": ["@data/**"] },
      { "groupName": "docx", "elementNamePattern": ["@docx", "@docx/**"] },
      { "groupName": "edit", "elementNamePattern": ["@edit/**"] },
      { "groupName": "generate", "elementNamePattern": ["@generate/**"] },
      { "groupName": "pdf", "elementNamePattern": ["@pdf", "@pdf/**"] },
      { "groupName": "sky", "elementNamePattern": ["@sky"] },
      { "groupName": "state", "elementNamePattern": ["@state/**"] },
      { "groupName": "theme", "elementNamePattern": ["@theme/**"] },
      { "groupName": "utils", "elementNamePattern": ["@utils/**"] },
      { "groupName": "weather", "elementNamePattern": ["@weather"] },
      { "groupName": "app", "elementNamePattern": ["@App", "@app/**"] },
      { "groupName": "styles", "elementNamePattern": ["@styles/**"] },
      { "groupName": "types", "elementNamePattern": ["types"] }
    ],
    "groups": [
      "react",
      "next",
      ["builtin", "external"],
      "assets",
      "components",
      "data",
      "docx",
      "edit",
      "generate",
      "pdf",
      "sky",
      "state",
      "theme",
      "utils",
      "weather",
      "styles",
      "app",
      "types",
      ["parent", "sibling", "index"],
      "style",
      "side_effect",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "out",
    ".next",
    "coverage",
    ".tmp",
    ".temp",
    "styled-system",
    "netlify.toml",
    "*.log",
    ".DS_Store",
    ".vscode",
    ".claude",
    ".superpowers",
    "bun.lock",
    "deno.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "*.min.js"
  ]
}
