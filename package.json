{
  "name": "codebender-portfolio",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "assert:no-react": "bun scripts/assert-no-react.mjs",
    "build": "bun run --sequential generate:cv build:vite assert:no-react",
    "build:vite": "vite build",
    "dev": "bun run --sequential generate:cv dev:vite",
    "dev:vite": "vite",
    "generate:cv": "bun scripts/generate-cv-pdf.tsx",
    "lint:ts": "oxlint --type-aware",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:css": "gale \"src/**/*.css\"",
    "lint:css:fix": "gale --fix \"src/**/*.css\"",
    "lint:actions": "github-actionlint",
    "spellcheck": "typos .",
    "spellcheck:fix": "typos --write-changes .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:staged": "lint-staged",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.node.json --noEmit && tsgo -p netlify/functions --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "system-check": "bun run --sequential format:check typecheck lint:ts lint:css lint:actions spellcheck test build"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@anthropic-ai/sdk": "0.126.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@netlify/blobs": "11.1.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.116.0",
    "buffer": "6.0.3",
    "docx": "9.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@analogjs/vitest-angular": "2.7.2",
    "@angular/build": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@codebend3r/gale": "0.2.4",
    "@netlify/functions": "6.0.0",
    "@ocular-d/typos-bin": "1.50.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "fflate": "0.8.3",
    "github-actionlint": "1.7.12",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@ocular-d/typos-bin"
  ]
}
