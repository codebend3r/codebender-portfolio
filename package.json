{
  "name": "portfolio-vite-react",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "pre-push": "bash bin/pre-push.sh",
    "preview": "vite preview",
    "prepare": "husky",
    "ts:check": "tsc && npx tsc --version",
    "system-check": "run-s prettier:check lint build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@svgr/rollup": "8.1.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.33.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "5.4.0"
  },
  "packageManager": "bun@1.1.22"
}
