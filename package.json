{
  "name": "portfolio-vite-react",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "pre-push": "bash bin/pre-push.sh",
    "preview": "vite preview",
    "prepare": "husky",
    "ts:check": "tsc && npx tsc --version",
    "system-check": "run-s prettier:check lint build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "vite": "8.0.12"
  },
  "packageManager": "bun@1.1.22"
}
