{
  "name": "codebender-portfolio",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "assert:no-react": "bun scripts/assert-no-react.mjs",
    "build": "run-s generate:cv build:vite assert:no-react",
    "build:vite": "vite build",
    "dev": "run-s generate:cv dev:vite",
    "dev:vite": "vite",
    "generate:cv": "bun scripts/generate-cv-pdf.tsx",
    "lint:ts": "oxlint --type-aware",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:staged": "lint-staged",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.node.json --noEmit && tsgo -p netlify/functions --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "run-p --aggregate-output --print-label typecheck lint:ts lint:css test",
    "system-check": "run-s format:check check build"
  },
  "dependencies": {
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@anthropic-ai/sdk": "0.110.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/source-sans-3": "5.2.9",
    "@fontsource/source-serif-4": "5.2.9",
    "@netlify/blobs": "10.7.9",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/supabase-js": "2.110.0",
    "buffer": "6.0.3",
    "docx": "9.7.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular/build": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@netlify/functions": "5.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.6",
    "fflate": "0.8.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.4.1",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  },
  "packageManager": "bun@1.3.14"
}
