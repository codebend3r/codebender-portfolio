{
  "name": "codebender-portfolio",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "bun run --sequential lint:ts lint:css lint:actions",
    "lint:ts": "oxlint --type-aware",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:css": "gale \"src/**/*.css\"",
    "lint:css:fix": "gale --fix \"src/**/*.css\"",
    "lint:actions": "github-actionlint",
    "spellcheck": "typos .",
    "spellcheck:fix": "typos --write-changes .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:staged": "lint-staged --concurrent false --relative",
    "preview": "vite preview",
    "prepare": "lefthook install --reset-hooks-path",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p netlify/functions --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "system-check": "bun run --sequential format:check typecheck lint spellcheck test build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@netlify/blobs": "11.1.4",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.118.0",
    "buffer": "6.0.3",
    "docx": "9.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.2.5",
    "@netlify/functions": "6.0.2",
    "@ocular-d/typos-bin": "1.51.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fflate": "0.8.3",
    "github-actionlint": "1.7.12",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@ocular-d/typos-bin"
  ]
}
