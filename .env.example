# Netlify function secrets — set these in the Netlify UI for deploys,
# and in a local .env for `netlify dev`. NEVER commit a real .env.
ANTHROPIC_API_KEY=sk-ant-...
GENERATE_PASSWORD=choose-a-strong-owner-password

# Supabase cloud sync (publishable values, safe in the client bundle).
# Set in the Netlify UI for deploys and in a local .env for `bun dev`.
# Cloud sync features stay hidden when these are absent.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
